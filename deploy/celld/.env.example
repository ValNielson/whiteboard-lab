# Copy to .env (or paste into the Arcane project's environment) and fill in.
# Use an R2 API token scoped to this one bucket, with Object Read & Write.
# Whoever holds these credentials controls the whole fleet.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CELLD_BUCKET=s3://whiteboard-lab-celld

# Host port the load balancer listens on. Point your existing proxy/tunnel here.
WB_PORT=8088

# Pin the celld version so laptop deploys and server nodes match.
CELLD_VERSION=0.6.3
