# Bundles the app and runs `celld deploy` into the stack's bucket. Used by the
# `deploy` service in compose.yaml; the build context is the repo root.
ARG CELLD_VERSION=0.6.3

FROM node:22-bookworm-slim AS esbuild
RUN mkdir /e && cd /e && npm init -y >/dev/null && npm install --no-audit --no-fund esbuild@0.25.10 >/dev/null \
 && cp node_modules/@esbuild/linux-*/bin/esbuild /usr/local/bin/esbuild

FROM ghcr.io/denoland/celld:${CELLD_VERSION}
COPY --from=esbuild /usr/local/bin/esbuild /usr/local/bin/esbuild
WORKDIR /app
COPY wrangler.json ./
COPY src ./src
COPY public ./public
ENTRYPOINT ["/usr/local/bin/celld", "deploy", "/app"]
